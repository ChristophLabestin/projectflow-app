VITE_FIREBASE_API_KEY=replace-with-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-firebase-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=replace-with-firebase-measurement-id
# Realtime Database URL — powers presence/online-state (onDisconnect). Enable
# Realtime Database in the Firebase console; the URL looks like
# https://<project-id>-default-rtdb.europe-west1.firebasedatabase.app
# Leave empty to disable presence (online indicators stay hidden).
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_VAPID_KEY=replace-with-firebase-web-push-certificate-key
VITE_CLOUD_FUNCTIONS_URL=https://europe-west3-replace-with-firebase-project-id.cloudfunctions.net/api
VITE_CLOUD_FUNCTIONS_BASE_URL=https://europe-west3-replace-with-firebase-project-id.cloudfunctions.net
VITE_PM_CORE_ONLY=true
VITE_AUDIT_SIGNUP_ENABLED=false
VITE_UNSPLASH_ACCESS_KEY=
GEMINI_API_KEY=
# Error monitoring (Sentry). Leave DSN empty to fully disable reporting.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_APP_VERSION=

# CORA Studio (/brainstorm) is hidden unless enabled.
VITE_CORA_STUDIO_ENABLED=false
