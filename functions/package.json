{
    "name": "functions",
    "scripts": {
        "lint": "eslint --ext .js,.ts .",
        "build": "tsc",
        "test:unit": "tsc && node --test scripts/unit/*.test.js",
        "test:triggers": "npm run build && node scripts/run-triggers-test.js",
        "test:account-data": "firebase emulators:exec --only firestore --project demo-projectflow --config scripts/firebase.account-data-test.json \"node scripts/account-data-test.js\"",
        "test:legal": "firebase emulators:exec --only firestore --project demo-projectflow --config scripts/firebase.legal-test.json \"node scripts/legal-test.js\"",
        "test:rules": "firebase emulators:exec --only firestore --project demo-projectflow --config ../firebase.json \"node scripts/firestore-rules-test.js\"",
        "build:watch": "tsc --watch",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "22"
    },
    "main": "lib/index.js",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.883.0",
        "@aws-sdk/s3-request-presigner": "^3.883.0",
        "@modelcontextprotocol/sdk": "^1.30.1",
        "@simplewebauthn/server": "^13.2.2",
        "cors": "^2.8.5",
        "firebase-admin": "^13.10.0",
        "firebase-functions": "^7.2.5",
        "google-auth-library": "^9.15.1",
        "jsonwebtoken": "^9.0.3",
        "nodemailer": "^8.0.10",
        "openai": "^6.25.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^4.0.1",
        "@types/cors": "^2.8.17",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/nodemailer": "^6.4.14",
        "@typescript-eslint/eslint-plugin": "^5.12.0",
        "@typescript-eslint/parser": "^5.12.0",
        "eslint": "^8.9.0",
        "eslint-plugin-import": "^2.25.4",
        "typescript": "^5.9.3"
    },
    "private": true
}
