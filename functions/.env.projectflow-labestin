# Non-secret mail config, loaded by the Firebase CLI on deploy (runbook: brain/operations/email-ses.md).
# Secrets (set by the user, never committed): AWS_SES_ACCESS_KEY_ID, AWS_SES_SECRET_ACCESS_KEY, SMTP_USER, SMTP_PASS.
# smtp = Google Workspace bridge until SES production access; switch back to ses afterwards.
EMAIL_TRANSPORT=smtp
SES_REGION=eu-north-1
SES_FROM="ProjectFlow <notifications@mail.getprojectflow.com>"
EMAIL_REPLY_TO=hello@getprojectflow.com
SES_CONFIGURATION_SET=projectflow-default
# Exact SNS topic ARN(s) allowed to post to sesEvents, comma separated. Empty = webhook rejects everything.
SES_SNS_TOPIC_ARNS=arn:aws:sns:eu-north-1:173433120074:projectflow-ses-events
# true = while SES is in the sandbox, unverified recipients go out via SMTP_* (only if SMTP is configured).
EMAIL_SMTP_FALLBACK=false
# System SMTP (Google Workspace, account in SMTP_USER, sends as the verified "Send mail as" alias).
SMTP_HOST=smtp.gmail.com
SMTP_ALLOWED_HOSTS=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM=hello@getprojectflow.com
SMTP_FROM_NAME=ProjectFlow
# Google Workspace caps ~2,000 recipients/day per user; keep headroom. Per instance pacing in mails/s.
SMTP_DAILY_LIMIT=1800
SMTP_MAX_SEND_RATE=0.5

# Storage: sign x-goog-content-length-range on GCS upload URLs (bucket CORS allows it since 2026-10-24)
GCS_SIGN_LENGTH_RANGE=true
