# Non-secret mail config, loaded by the Firebase CLI on deploy (runbook: brain/operations/email-ses.md).
# Secrets (set by the user, never committed): AWS_SES_ACCESS_KEY_ID, AWS_SES_SECRET_ACCESS_KEY.
EMAIL_TRANSPORT=ses
SES_REGION=eu-north-1
SES_FROM="ProjectFlow <notifications@mail.getprojectflow.com>"
EMAIL_REPLY_TO=hello@getprojectflow.com
SES_CONFIGURATION_SET=projectflow-default
# Exact SNS topic ARN(s) allowed to post to sesEvents, comma separated. Empty = webhook rejects everything.
SES_SNS_TOPIC_ARNS=arn:aws:sns:eu-north-1:173433120074:projectflow-ses-events
# true = while SES is in the sandbox, unverified recipients go out via SMTP_* (only if SMTP is configured).
EMAIL_SMTP_FALLBACK=false
