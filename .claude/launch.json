{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-emulator",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:emulator",
        "--prefix",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "web",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "web-emu-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "web",
        "vite",
        "preview",
        "web",
        "--mode",
        "emulator",
        "--outDir",
        "/tmp/pf-emu-dist",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "web-e2e",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3000
    },
    {
      "name": "web-e2e-isolated",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3010",
        "AUTH_PORT=9731",
        "FIRESTORE_PORT=8731",
        "STORAGE_PORT=9732",
        "FUNCTIONS_PORT=5731",
        "npm",
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3010,
      "autoPort": false
    },
    {
      "name": "web-e2e-web-session",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3061",
        "AUTH_PORT=9761",
        "FIRESTORE_PORT=8761",
        "STORAGE_PORT=9762",
        "FUNCTIONS_PORT=5761",
        "npm",
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3061
    },
    {
      "name": "web-e2e-legal",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3081",
        "AUTH_PORT=9841",
        "FIRESTORE_PORT=8841",
        "STORAGE_PORT=9842",
        "FUNCTIONS_PORT=5841",
        "E2E_LEGAL=1",
        "npm",
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3081
    },
    {
      "name": "landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "landing"
      ],
      "port": 4300
    },
    {
      "name": "web-ai-emulator",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_EMULATOR_AUTH_PORT=9951",
        "VITE_EMULATOR_FIRESTORE_PORT=8951",
        "VITE_EMULATOR_FUNCTIONS_PORT=5951",
        "npm",
        "run",
        "dev:emulator",
        "--prefix",
        "web",
        "--",
        "--port",
        "3020",
        "--strictPort"
      ],
      "port": 3020
    },
    {
      "name": "web-e2e-crash",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3091",
        "AUTH_PORT=9851",
        "FIRESTORE_PORT=8851",
        "STORAGE_PORT=9852",
        "FUNCTIONS_PORT=5851",
        "E2E_ADMIN=1",
        "npm",
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3091
    },
    {
      "name": "web-ui-sweep",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3071",
        "AUTH_PORT=9771",
        "FIRESTORE_PORT=8771",
        "STORAGE_PORT=9772",
        "FUNCTIONS_PORT=5771",
        "npm",
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3071
    },
    {
      "name": "web-e2e-web-session-signed-out",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "E2E_LOGIN=none",
        "PORT=3061",
        "AUTH_PORT=9761",
        "FIRESTORE_PORT=8761",
        "STORAGE_PORT=9762",
        "FUNCTIONS_PORT=5761",
        "npm",
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3061
    },
    {
      "name": "web-e2e-help",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3081",
        "AUTH_PORT=9781",
        "FIRESTORE_PORT=8781",
        "STORAGE_PORT=9782",
        "FUNCTIONS_PORT=5781",
        "npm",
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3081
    },
    {
      "name": "web-motion",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3091",
        "AUTH_PORT=9791",
        "FIRESTORE_PORT=8791",
        "STORAGE_PORT=9792",
        "FUNCTIONS_PORT=5791",
        "E2E_FUNCTIONS=0",
        "npm",
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3091,
      "autoPort": false
    }
  ]
}
