{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-emulator",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:emulator",
        "--prefix",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "web",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}