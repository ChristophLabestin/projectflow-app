{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-emulator",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:emulator",
        "--prefix",
        "web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "web",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "web-emu-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "web",
        "vite",
        "preview",
        "web",
        "--mode",
        "emulator",
        "--outDir",
        "/tmp/pf-emu-dist",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "web-e2e",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3000
    },
    {
      "name": "web-e2e-isolated",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3010",
        "AUTH_PORT=9731",
        "FIRESTORE_PORT=8731",
        "STORAGE_PORT=9732",
        "FUNCTIONS_PORT=5731",
        "npm",
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3010,
      "autoPort": false
    },
    {
      "name": "web-e2e-web-session",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3061",
        "AUTH_PORT=9761",
        "FIRESTORE_PORT=8761",
        "STORAGE_PORT=9762",
        "FUNCTIONS_PORT=5761",
        "npm",
        "run",
        "dev:e2e",
        "--prefix",
        "web"
      ],
      "port": 3061
    }
  ]
}
