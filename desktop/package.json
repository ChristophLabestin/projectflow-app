{
  "name": "projectflow-desktop",
  "productName": "ProjectFlow",
  "version": "0.1.0",
  "private": true,
  "description": "ProjectFlow desktop shell (Electron) around the hosted web app",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs && node scripts/brand-dev-app.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run build && PF_DESKTOP_URL=${PF_DESKTOP_URL:-http://localhost:3000} electron .",
    "dev:e2e": "bash ../scripts/dev-desktop.sh",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "pack": "npm run build && electron-builder --dir",
    "postinstall": "node scripts/brand-dev-app.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "author": "Labestin Digital",
  "build": {
    "appId": "de.christophlabestin.projectflow.desktop",
    "productName": "ProjectFlow",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "protocols": [
      {
        "name": "ProjectFlow",
        "schemes": [
          "projectflow"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "afterPack": "./scripts/after-pack.cjs"
  }
}
