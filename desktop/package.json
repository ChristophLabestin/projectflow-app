{
  "name": "projectflow-desktop",
  "productName": "ProjectFlow",
  "version": "0.1.4",
  "private": true,
  "description": "ProjectFlow desktop app",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs && node scripts/brand-dev-app.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm run build && PF_DESKTOP_URL=${PF_DESKTOP_URL:-http://localhost:3000} electron .",
    "dev:e2e": "bash ../scripts/dev-desktop.sh",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "pack": "npm run build && electron-builder --dir",
    "postinstall": "node scripts/brand-dev-app.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "author": "Labestin Digital",
  "build": {
    "appId": "de.christophlabestin.projectflow.desktop",
    "productName": "ProjectFlow",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "!dist/native/**",
      "assets/**",
      "package.json"
    ],
    "protocols": [
      {
        "name": "ProjectFlow",
        "schemes": [
          "projectflow"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "extendInfo": {
        "NSCalendarsUsageDescription": "ProjectFlow reads your upcoming meetings to pause your focus task and to offer capturing meeting notes.",
        "NSCalendarsFullAccessUsageDescription": "ProjectFlow reads your upcoming meetings to pause your focus task and to offer capturing meeting notes.",
        "NSUserActivityTypes": [
          "com.apple.corespotlightitem"
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Attachment",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "None",
            "LSItemContentTypes": [
              "public.item"
            ]
          }
        ]
      },
      "extraResources": [
        {
          "from": "dist/native",
          "to": "native",
          "filter": [
            "pf-calendar"
          ]
        }
      ],
      "extraFiles": [
        {
          "from": "dist/native",
          "to": "MacOS",
          "filter": [
            "pf-spotlight"
          ]
        }
      ],
      "artifactName": "ProjectFlow-mac.${ext}",
      "x64ArchFiles": "Contents/{Resources/native/pf-calendar,MacOS/pf-spotlight}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "ProjectFlow-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "ProjectFlow-Setup.${ext}",
      "shortcutName": "ProjectFlow",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "ProjectFlow-linux.${ext}"
    },
    "afterPack": "./scripts/after-pack.cjs",
    "copyright": "© Labestin Digital",
    "publish": [
      {
        "provider": "github",
        "owner": "ChristophLabestin",
        "repo": "projectflow-app",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "title": "ProjectFlow",
      "artifactName": "ProjectFlow-mac.dmg"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
