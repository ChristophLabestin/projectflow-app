rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function authed() {
      return request.auth != null;
    }

    // Membership is sourced from Firestore (tenants/{tenantId}/members/{uid})
    // so storage access matches firestore.rules. Guests are not full members and
    // get no storage access.
    function memberPath(tenantId) {
      return /databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function isFullMember(tenantId) {
      return authed() &&
        firestore.exists(memberPath(tenantId)) &&
        firestore.get(memberPath(tenantId)).data.role != 'Guest';
    }

    // Allowlist: no text/html, image/svg+xml or javascript (stored XSS).
    function isAllowedContentType() {
      return request.resource.contentType != null &&
        request.resource.contentType.matches(
          '(image/(png|jpeg|gif|webp|avif|bmp|heic|heif)|' +
          'video/.*|audio/.*|' +
          'application/pdf|' +
          'application/msword|' +
          'application/vnd\\.openxmlformats-officedocument\\..*|' +
          'application/vnd\\.ms-(excel|powerpoint)|' +
          'application/vnd\\.oasis\\.opendocument\\..*|' +
          'text/plain|text/csv|' +
          'application/zip|application/x-zip-compressed)'
        );
    }

    function isImageType() {
      return request.resource.contentType != null &&
        request.resource.contentType.matches('image/(png|jpeg|gif|webp|avif|bmp|heic|heif)');
    }

    // One member + one project lookup (Storage rules allow few Firestore calls per request).
    function memberRole(tenantId) {
      return firestore.get(memberPath(tenantId)).data.role;
    }

    function canAccessProject(tenantId, projectId) {
      let project = firestore.get(/databases/(default)/documents/tenants/$(tenantId)/projects/$(projectId));
      return project != null && (
        memberRole(tenantId) != 'Guest' ||
        project.data.ownerId == request.auth.uid ||
        request.auth.uid in project.data.get('memberIds', [])
      );
    }

    // File manager objects: tenants/{t}/files/{module}/{scope}/... where scope is a projectId or
    // 'global' (workspace files). Access mirrors the Firestore `files` rule; objects are written
    // only through signed upload URLs from Cloud Functions.
    match /tenants/{tenantId}/files/{module}/{scope}/{allPaths=**} {
      allow read: if authed() && firestore.exists(memberPath(tenantId)) && (
        scope == 'global' ? memberRole(tenantId) != 'Guest' : canAccessProject(tenantId, scope)
      );
      allow write: if false;
    }

    // Other tenant-scoped storage (project assets, media, etc.). Non-guest members only.
    match /tenants/{tenantId}/{segment}/{allPaths=**} {
      allow read: if segment != 'files' && isFullMember(tenantId);
      allow create, update: if segment != 'files' && isFullMember(tenantId) &&
        request.resource.size < 25 * 1024 * 1024 &&
        isAllowedContentType();
      allow delete: if segment != 'files' && isFullMember(tenantId);
    }

    // Users may only read/write their own avatar namespace (images, max 5 MB).
    match /users/{userId}/{allPaths=**} {
      allow read: if authed() && request.auth.uid == userId;
      allow create, update: if authed() && request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        isImageType();
      allow delete: if authed() && request.auth.uid == userId;
    }
  }
}
