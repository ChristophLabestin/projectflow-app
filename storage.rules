rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function authed() {
      return request.auth != null;
    }

    // Membership is sourced from Firestore (tenants/{tenantId}/members/{uid})
    // so storage access matches firestore.rules. Guests are not full members and
    // get no storage access.
    function memberPath(tenantId) {
      return /databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function isFullMember(tenantId) {
      return authed() &&
        firestore.exists(memberPath(tenantId)) &&
        firestore.get(memberPath(tenantId)).data.role != 'Guest';
    }

    // Allowlist: no text/html, image/svg+xml or javascript (stored XSS).
    function isAllowedContentType() {
      return request.resource.contentType != null &&
        request.resource.contentType.matches(
          '(image/(png|jpeg|gif|webp|avif|bmp|heic|heif)|' +
          'video/.*|audio/.*|' +
          'application/pdf|' +
          'application/msword|' +
          'application/vnd\\.openxmlformats-officedocument\\..*|' +
          'application/vnd\\.ms-(excel|powerpoint)|' +
          'application/vnd\\.oasis\\.opendocument\\..*|' +
          'text/plain|text/csv|' +
          'application/zip|application/x-zip-compressed)'
        );
    }

    function isImageType() {
      return request.resource.contentType != null &&
        request.resource.contentType.matches('image/(png|jpeg|gif|webp|avif|bmp|heic|heif)');
    }

    // One member + one project lookup (Storage rules allow few Firestore calls per request).
    function memberRole(tenantId) {
      return firestore.get(memberPath(tenantId)).data.role;
    }

    function canAccessProject(tenantId, projectId) {
      let project = firestore.get(/databases/(default)/documents/tenants/$(tenantId)/projects/$(projectId));
      return project != null && (
        memberRole(tenantId) != 'Guest' ||
        project.data.ownerId == request.auth.uid ||
        request.auth.uid in project.data.get('memberIds', [])
      );
    }

    // File manager objects: tenants/{t}/files/{module}/{scope}/... where scope is a projectId or
    // 'global' (workspace files). Access mirrors the Firestore `files` rule; objects are written
    // only through signed upload URLs from Cloud Functions.
    match /tenants/{tenantId}/files/{module}/{scope}/{allPaths=**} {
      allow read: if authed() && firestore.exists(memberPath(tenantId)) && (
        scope == 'global' ? memberRole(tenantId) != 'Guest' : canAccessProject(tenantId, scope)
      );
      allow write: if false;
    }

    // Public form assets (logo, cover, background): readable by anyone, written only via signed URLs
    // from Cloud Functions (createFormAssetUpload).
    match /public/forms/{tenantId}/{formId}/assets/{file} {
      allow read: if true;
      allow write: if false;
    }

    // Suspended workspaces (admin console) are closed for direct storage access too.
    // Costs one Firestore read; with the member lookup that is the 2 reads Storage rules allow.
    function tenantActive(tenantId) {
      return firestore.get(/databases/(default)/documents/tenants/$(tenantId)).data.get('suspendedAt', null) == null;
    }

    function canWriteMedia(tenantId, maxBytes) {
      return isFullMember(tenantId) && tenantActive(tenantId) &&
        request.resource.size < maxBytes &&
        isAllowedContentType();
    }

    // Direct SDK access is limited to these segments (audit 2026-10-24, M3); everything else under
    // tenants/{t}/ — including module objects written via signed URLs — is closed (default deny).
    // Quotas apply to the Cloud Functions upload pipeline; these direct paths keep tight size caps.

    // Project media and assets (media library, project overview).
    match /tenants/{tenantId}/projects/{allPaths=**} {
      allow read: if isFullMember(tenantId) && tenantActive(tenantId);
      allow create, update: if canWriteMedia(tenantId, 25 * 1024 * 1024);
      allow delete: if isFullMember(tenantId) && tenantActive(tenantId);
    }

    // Personal media inside a workspace: only its owner.
    match /tenants/{tenantId}/users/{userId}/{allPaths=**} {
      allow read, delete: if authed() && request.auth.uid == userId && isFullMember(tenantId) && tenantActive(tenantId);
      allow create, update: if authed() && request.auth.uid == userId && canWriteMedia(tenantId, 25 * 1024 * 1024);
    }

    // Invoice logos (images, max 5 MB).
    match /tenants/{tenantId}/invoices/logos/{allPaths=**} {
      allow read, delete: if isFullMember(tenantId) && tenantActive(tenantId);
      allow create, update: if isFullMember(tenantId) && tenantActive(tenantId) &&
        request.resource.size < 5 * 1024 * 1024 && isImageType();
    }

    // Users may only read/write their own avatar namespace (images, max 5 MB).
    match /users/{userId}/{allPaths=**} {
      allow read: if authed() && request.auth.uid == userId;
      allow create, update: if authed() && request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024 &&
        isImageType();
      allow delete: if authed() && request.auth.uid == userId;
    }
  }
}
