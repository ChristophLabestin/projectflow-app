rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function authed() {
      return request.auth != null;
    }

    // Membership is sourced from Firestore (tenants/{tenantId}/members/{uid})
    // so storage access matches firestore.rules. Tenant ids are random and no
    // longer equal the owner's uid.
    function canAccessTenant(tenantId) {
      return authed() &&
        firestore.exists(
          /databases/(default)/documents/tenants/$(tenantId)/members/$(request.auth.uid)
        );
    }

    // Tenant-scoped storage (projects, media, etc.). Only members of that tenant may read/write — no cross-tenant access.
    match /tenants/{tenantId}/{allPaths=**} {
      allow read, write: if canAccessTenant(tenantId);
    }

    // Users may only read/write their own avatar namespace.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if authed() && request.auth.uid == userId;
    }
  }
}
