rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    function isOwner(tenantId) {
      return authed() && request.auth.uid == tenantId;
    }

    function tenantExists(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId));
    }

    function isTenantMember(tenantId) {
      return authed() &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    function canAccessTenant(tenantId) {
      return isOwner(tenantId) || isTenantMember(tenantId);
    }

    function isProjectMember(projectData) {
      return authed() && (
        projectData.ownerId == request.auth.uid ||
        (
          ('memberIds' in projectData) &&
          request.auth.uid in projectData.memberIds
        )
      );
    }

    function projectExists(tenantId, projectId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(projectId));
    }

    function projectData(tenantId, projectId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(projectId)).data;
    }

    function canAccessProjectById(tenantId, projectId) {
      return canAccessTenant(tenantId) ||
        (
          projectExists(tenantId, projectId) &&
          isProjectMember(projectData(tenantId, projectId))
        );
    }

    function canAccessScopedDoc(data) {
      return authed() && (
        (('tenantId' in data) && canAccessTenant(data.tenantId)) ||
        (
          ('tenantId' in data) &&
          ('projectId' in data) &&
          canAccessProjectById(data.tenantId, data.projectId)
        ) ||
        (('ownerId' in data) && data.ownerId == request.auth.uid) ||
        (('createdBy' in data) && data.createdBy == request.auth.uid) ||
        (('userId' in data) && data.userId == request.auth.uid)
      );
    }

    function canSelfCreateMembership(tenantId, userId) {
      return authed() &&
        tenantExists(tenantId) &&
        request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        (
          !('role' in request.resource.data) ||
          request.resource.data.role == 'Member'
        );
    }

    function canSelfUpdateMembership(userId) {
      return authed() &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role;
    }

    // Public marketing intake. These remain write-only from clients.
    match /waitlist/{email} {
      allow create: if true;
    }

    match /newsletter/{email} {
      allow create: if true;
    }

    match /contact_submissions/{doc} {
      allow create: if true;
    }

    match /blog_posts/{post} {
      allow read: if true;
    }

    match /news/{doc} {
      allow read: if true;
    }

    // Global user profiles
    match /users/{userId} {
      allow read: if authed();
      allow write: if authed() && request.auth.uid == userId;
    }

    match /tenants/{tenantId} {
      allow read: if canAccessTenant(tenantId);
      allow create, update, delete: if isOwner(tenantId);

      match /members/{userId} {
        allow read: if canAccessTenant(tenantId);
        allow create: if isOwner(tenantId) || canSelfCreateMembership(tenantId, userId);
        allow update: if isOwner(tenantId) || canSelfUpdateMembership(userId);
        allow delete: if isOwner(tenantId) || (authed() && request.auth.uid == userId);
      }

      match /presence/{presenceId} {
        allow read, write: if canAccessTenant(tenantId);
      }

      match /secrets/{secretId} {
        allow read, write: if false;
      }

      match /api_tokens/{tokenId} {
        allow read, write: if false;
      }

      match /entitlements/{docId} {
        allow read: if canAccessTenant(tenantId);
        allow write: if isOwner(tenantId);
      }

      match /invite_links/{linkId} {
        allow read: if true;
        allow create, update, delete: if isOwner(tenantId);
      }

      match /inviteLinks/{linkId} {
        allow read: if true;
        allow create, update, delete: if isOwner(tenantId);
      }

      match /projects/{projectId} {
        allow read: if canAccessProjectById(tenantId, projectId);
        allow create: if canAccessTenant(tenantId);
        allow update, delete: if canAccessProjectById(tenantId, projectId);

        match /{document=**} {
          allow read, write: if canAccessProjectById(tenantId, projectId);
        }
      }

      // User-owned tenant data (for example personal tasks)
      match /users/{userId}/{document=**} {
        allow read, write: if authed() && request.auth.uid == userId && canAccessTenant(tenantId);
      }

      // Finance V2 collections are write-protected for clients.
      // Mutations must go through callable/HTTP Cloud Functions for auditability.
      match /{financeCollection}/{docId} {
        allow read: if canAccessTenant(tenantId) && financeCollection.matches('finance_.*');
        allow write: if false;
      }

      // Other direct tenant-scoped collections (notifications, groups, api tokens, etc.)
      match /{subcollection}/{docId} {
        allow read, write: if canAccessTenant(tenantId) &&
          !(
            subcollection.matches('finance_.*') ||
            subcollection in [
              'members',
              'presence',
              'secrets',
              'entitlements',
              'invite_links',
              'inviteLinks',
              'projects',
              'users',
              'api_tokens'
            ]
          );
      }
    }

    // Collection group access for project discovery
    match /{path=**}/projects/{projectId} {
      allow read: if canAccessScopedDoc(resource.data) || isProjectMember(resource.data);
    }

    match /{path=**}/tasks/{taskId} {
      allow read: if canAccessScopedDoc(resource.data);
    }

    match /{path=**}/ideas/{ideaId} {
      allow read: if canAccessScopedDoc(resource.data);
    }

    match /{path=**}/issues/{issueId} {
      allow read: if canAccessScopedDoc(resource.data);
    }

    // Legacy top-level social collections. New writes should be project-scoped.
    match /social_campaigns/{docId} {
      allow read: if canAccessScopedDoc(resource.data);
      allow create: if canAccessScopedDoc(request.resource.data);
      allow update, delete: if canAccessScopedDoc(resource.data);
    }

    match /social_posts/{docId} {
      allow read: if canAccessScopedDoc(resource.data);
      allow create: if canAccessScopedDoc(request.resource.data);
      allow update, delete: if canAccessScopedDoc(resource.data);
    }

    match /social_assets/{docId} {
      allow read: if canAccessScopedDoc(resource.data);
      allow create: if canAccessScopedDoc(request.resource.data);
      allow update, delete: if canAccessScopedDoc(resource.data);
    }

    match /caption_presets/{docId} {
      allow read: if canAccessScopedDoc(resource.data);
      allow create: if canAccessScopedDoc(request.resource.data);
      allow update, delete: if canAccessScopedDoc(resource.data);
    }

    match /social_strategy/{docId} {
      allow read: if canAccessScopedDoc(resource.data);
      allow create: if canAccessScopedDoc(request.resource.data);
      allow update, delete: if canAccessScopedDoc(resource.data);
    }
  }
}
