rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    // ---- Workspace (tenant) membership --------------------------------------
    // Tenants have random ids and an `ownerId`. Access is granted solely by
    // tenants/{tenantId}/members/{uid}. Roles: Owner | Admin | Member | Guest.
    // Guests only see projects whose `memberIds` contain them.

    function memberPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function tenantExists(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId));
    }

    // Platform admins can suspend a workspace (admin console, `tenants/{id}.suspendedAt`): members keep
    // reading the tenant doc and their membership (the app shows the suspension notice), everything else closes.
    function tenantActive(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)).data.get('suspendedAt', null) == null;
    }

    function isTenantMemberAnyState(tenantId) {
      return authed() && exists(memberPath(tenantId));
    }

    function isTenantMember(tenantId) {
      return isTenantMemberAnyState(tenantId) && tenantActive(tenantId);
    }

    function memberRole(tenantId) {
      return get(memberPath(tenantId)).data.role;
    }

    // Full members see all workspace data (everyone except guests).
    function isFullMember(tenantId) {
      return isTenantMember(tenantId) && memberRole(tenantId) != 'Guest';
    }

    function isTenantAdmin(tenantId) {
      return isTenantMember(tenantId) && memberRole(tenantId) in ['Owner', 'Admin'];
    }

    function isOwner(tenantId) {
      return isTenantMember(tenantId) && memberRole(tenantId) == 'Owner';
    }

    // ---- Plan entitlements (brain/plans/billing-implementation.md) ----------
    // tenants/{tenantId}/entitlements/plan is written by Cloud Functions only. A missing doc is a
    // legacy workspace in grace and is not limited.
    // Collection names only Cloud Functions write; never creatable as nested client data.
    function isServerOnlyName(name) {
      return name in ['members', 'invitations', 'entitlements', 'ai_config', 'ai_credits', 'secrets', 'api_tokens',
        'users', 'automations', 'automation_runs', 'files', 'activity', 'legal_acceptances'];
    }

    function planPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/entitlements/plan;
    }

    // Every creation path writes the entitlement doc together with the tenant (web, iOS, personal, purchase page),
    // so a missing doc means "no plan" = no new projects (security review 2026-10-24).
    function withinProjectLimit(tenantId) {
      return exists(planPath(tenantId)) && (
        get(planPath(tenantId)).data.get('projectLimit', null) == null ||
        get(planPath(tenantId)).data.get('projectCount', 0) < get(planPath(tenantId)).data.projectLimit);
    }

    // Projects over the Free limit stay readable but are read-only (no data loss).
    function projectLocked(tenantId, projectId) {
      return exists(planPath(tenantId)) &&
        projectId in get(planPath(tenantId)).data.get('lockedProjectIds', []);
    }

    // Missing entitlement doc = Free (safe default, security review 2026-10-24): no invitations.
    function planAllowsInvites(tenantId) {
      return exists(planPath(tenantId)) &&
        get(planPath(tenantId)).data.get('invitesAllowed', false) == true;
    }

    // Kept for readability at call sites: full workspace access.
    function canAccessTenant(tenantId) {
      return isFullMember(tenantId);
    }

    // Forms (brain/plans/forms-concept.md §10): owner, editors and Owner/Admin. Custom roles with
    // tenant.forms.manageAll are served by Cloud Functions, rules cannot read custom roles cheaply.
    function canEditFormData(tenantId, form) {
      return isTenantAdmin(tenantId) ||
        (isFullMember(tenantId) && (form.get('ownerId', '') == request.auth.uid || request.auth.uid in form.get('editorIds', [])));
    }

    function canEditForm(tenantId, formId) {
      return canEditFormData(tenantId, get(/databases/$(database)/documents/tenants/$(tenantId)/forms/$(formId)).data);
    }

    // Workspace legal details shown on public forms: controller, privacy policy, imprint.
    function validTenantLegal(data) {
      return !('legal' in data) || (
        data.legal is map &&
        data.legal.keys().hasOnly(['controllerName', 'privacyPolicyUrl', 'imprintUrl', 'contactEmail']) &&
        (!('controllerName' in data.legal) || (data.legal.controllerName is string && data.legal.controllerName.size() <= 200)) &&
        (!('privacyPolicyUrl' in data.legal) || (data.legal.privacyPolicyUrl is string && data.legal.privacyPolicyUrl.size() <= 500 && (data.legal.privacyPolicyUrl == '' || data.legal.privacyPolicyUrl.matches('^https://.+')))) &&
        (!('imprintUrl' in data.legal) || (data.legal.imprintUrl is string && data.legal.imprintUrl.size() <= 500 && (data.legal.imprintUrl == '' || data.legal.imprintUrl.matches('^https://.+')))) &&
        (!('contactEmail' in data.legal) || (data.legal.contactEmail is string && data.legal.contactEmail.size() <= 254))
      );
    }

    function isProjectMember(projectData) {
      return authed() && (
        projectData.ownerId == request.auth.uid ||
        (
          ('memberIds' in projectData) &&
          request.auth.uid in projectData.memberIds
        )
      );
    }

    function projectExists(tenantId, projectId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(projectId));
    }

    function projectData(tenantId, projectId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/projects/$(projectId)).data;
    }

    function canAccessProjectById(tenantId, projectId) {
      return isFullMember(tenantId) ||
        (
          isTenantMember(tenantId) &&
          projectExists(tenantId, projectId) &&
          isProjectMember(projectData(tenantId, projectId))
        );
    }

    function canAccessScopedDoc(data) {
      return authed() && ('tenantId' in data) && (
        isFullMember(data.tenantId) ||
        (('projectId' in data) && canAccessProjectById(data.tenantId, data.projectId))
      );
    }

    // The creator of a brand-new workspace adds themselves as Owner in the
    // same batch as the tenant doc (getAfter sees the pending tenant write).
    // Admins manage non-owner members; only the owner may grant/revoke Admin.
    function canManageMemberRole(tenantId, fromRole, toRole) {
      return isTenantAdmin(tenantId) &&
        fromRole != 'Owner' && toRole != 'Owner' &&
        (isOwner(tenantId) || (fromRole != 'Admin' && toRole != 'Admin'));
    }

    // Data of the removed Social and Marketing (email, ads, recipients)
    // modules. Kept in Firestore but closed to clients; social_integrations
    // holds platform access tokens. Admin SDK (functions) is unaffected.
    function isRetiredProjectCollection(name) {
      return name in [
        'socialCampaigns',
        'socialPosts',
        'socialAssets',
        'social_integrations',
        'social_strategy',
        'caption_presets',
        'paidAds',
        'emailTemplates',
        'email_templates',
        'email_components',
        'marketing_recipients',
        'marketing_recipient_columns',
        'marketing_groups',
        'marketing_group_columns'
      ];
    }

    function canSelfUpdateMembership(userId) {
      return authed() &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'roleIds', 'uid', 'inviteId']);
    }

    // Old landing intake (legacy, read via adminApi leads.list). New signups go through the double-opt-in
    // endpoints (functions/src/platform-newsletter), so clients no longer write here.
    match /waitlist/{email} {
      allow read, write: if false;
    }

    match /newsletter/{email} {
      allow read, write: if false;
    }

    match /contact_submissions/{doc} {
      allow create: if true;
    }

    match /blog_posts/{post} {
      allow read: if true;
    }

    match /news/{doc} {
      allow read: if true;
    }

    // ---- Versioned legal documents (contract: brain/plans/legal-consent-contract.md)
    // Published index + immutable versions are public (landing page, iOS, signed-out
    // /legal pages). Drafts and all writes go through Cloud Functions (adminApi), never the client.
    match /legal_documents/{type} {
      allow read: if true;
      allow write: if false;

      match /versions/{version} {
        allow read: if true;
        allow write: if false;
      }

      // Drafts: only through adminApi in the admin console (admin/).
      match /drafts/{draftId} {
        allow read, write: if false;
      }
    }

    // Admin console (admin/, brain/plans/admin-console-concept.md): allowlist, sessions, audit log
    // and platform config are read and written only by the adminApi function (Admin SDK).
    match /platform_admins/{uid} {
      allow read, write: if false;
    }
    match /admin_sessions/{uid} {
      allow read, write: if false;
    }
    match /admin_audit/{entryId} {
      allow read, write: if false;
    }
    match /admin_config/{docId} {
      allow read, write: if false;
    }
    // Mail delivery (functions/src/email-events.ts): SES suppression list + daily counters, server-only.
    match /email_suppressions/{id} { allow read, write: if false; }
    match /email_stats/{day} { allow read, write: if false; }
    // Public endpoint rate limits (functions/src/public-rate-limit.ts), server-only.
    match /public_rate_limits/{id} { allow read, write: if false; }
    // Public form index by share token (brain/plans/forms-concept.md §4): served by getPublicForm only.
    match /public_forms/{token} { allow read, write: if false; }
    // Platform waitlist + newsletter (brain/plans/newsletter-contract.md): only Cloud Functions / adminApi.
    match /platform_subscribers/{id} {
      allow read, write: if false;
      match /consent_log/{entry} { allow read, write: if false; }
    }
    match /platform_optin_tokens/{id} { allow read, write: if false; }
    match /platform_campaigns/{id} {
      allow read, write: if false;
      match /sends/{subscriberId} { allow read, write: if false; }
    }
    // Emulator mail sink (functions/src/email.ts), never used in production.
    match /dev_outbox/{id} { allow read, write: if false; }
    // Admin MCP (functions/src/admin-console/mcp): clients, requests, codes, grants, tokens, pending confirmations.
    match /admin_mcp_clients/{id} { allow read, write: if false; }
    match /admin_mcp_requests/{id} { allow read, write: if false; }
    match /admin_mcp_codes/{id} { allow read, write: if false; }
    match /admin_mcp_grants/{id} { allow read, write: if false; }
    match /admin_mcp_tokens/{id} { allow read, write: if false; }
    match /admin_mcp_pending/{id} { allow read, write: if false; }
    // Billing availability for clients (brain/plans/billing-entitlements-contract.md §2):
    // `billing_public/config.checkoutAvailable`. Written server-side only (functions/scripts/billing-config.mjs).
    match /billing_public/{docId} {
      allow read: if authed();
      allow write: if false;
    }
    // Platform-wide config written by the admin console. `announcement` (banner for all users) is public.
    match /platform_config/{docId} {
      allow read: if docId == 'announcement';
      allow write: if false;
    }

    // Crash reports (web + iOS, opt-in): written only by the crashIngest function, read and triaged only
    // through adminApi in the admin console (admin/) — no client access, platform admins included.
    match /crashIssues/{issueId} {
      allow read, write: if false;

      match /crashEvents/{eventId} {
        allow read, write: if false;
      }
    }

    // Per-user consent record: readable by its owner, written only by the
    // acceptLegalDocuments / declineLegalDocuments callables (current version only).
    match /legal_acceptances/{userId} {
      allow get: if authed() && request.auth.uid == userId;
      allow list, write: if false;

      match /events/{eventId} {
        allow read: if authed() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Mail send jobs and per-recipient logs: Admin SDK only.
    match /legal_mail_jobs/{document=**} {
      allow read, write: if false;
    }

    // Global user profiles
    match /users/{userId} {
      // Profiles (name, avatar, email) are fetched by uid for co-workers; listing
      // the collection is not allowed so nobody can enumerate every account.
      // Owner-only data (AI usage, last workspace) lives under private/*.
      allow get: if authed();
      allow list: if false;
      allow write: if authed() && request.auth.uid == userId;

      // Owner-only secrets (e.g. GitHub token at private/github). The parent
      // profile is readable by every signed-in user, so secrets must live here.
      match /private/{docId} {
        allow read, write: if authed() && request.auth.uid == userId;
      }

      // In-app AI conversation per object (owner only, 30-day TTL via expireAt).
      match /ai_threads/{threadId} {
        allow read, delete: if authed() && request.auth.uid == userId;
        allow create, update: if authed() && request.auth.uid == userId
          && request.resource.data.messages is list && request.resource.data.messages.size() <= 40;
      }

      // Passkeys (WebAuthn credentials). They are created and verified
      // server-side via Cloud Functions (admin SDK bypasses these rules), so
      // the client never needs create. The owner may list and delete their own
      // passkeys, and rename them — but a label-only update prevents tampering
      // with the stored counter or public key.
      match /passkeys/{passkeyId} {
        allow read, delete: if authed() && request.auth.uid == userId;
        allow update: if authed() && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label']);
      }

      // WebAuthn challenges are written and consumed only by Cloud Functions.
      match /passkey_challenges/{challengeId} {
        allow read, write: if false;
      }

      // iOS devices ({ fcmToken, liveActivityStartToken, ... }) and running Live Activities
      // ({ pushToken, itemId, ... }). Written by the app, read by the Cloud Function that
      // pushes focus changes; owner only.
      match /devices/{deviceId} {
        allow read, write: if authed() && request.auth.uid == userId;
      }

      match /liveActivities/{activityId} {
        allow read, write: if authed() && request.auth.uid == userId;
      }

      // Per-day idempotency log of the scheduled nudges (sendNudges): server only.
      match /nudgeLog/{day} {
        allow read, write: if false;
      }
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMemberAnyState(tenantId);
      // Workspaces are created only by Cloud Functions (createTeamWorkspace, ensurePersonalWorkspace, purchase webhook),
      // always together with their owner membership and plan entitlement (security review 2026-10-24).
      allow create: if false;
      // `limits` is the platform-admin quota override (flows); never client-written (audit 2026-10-24, H4).
      allow update: if isTenantAdmin(tenantId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['suspendedAt', 'suspendedReason', 'suspendedBy', 'workspaceType', 'isReviewAccount', 'limits']) &&
        (isOwner(tenantId) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId'])) &&
        validTenantLegal(request.resource.data) &&
        (resource.data.get('workspaceType', 'team') != 'personal' ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']));
      allow delete: if isOwner(tenantId) && resource.data.get('workspaceType', 'team') != 'personal';

      match /members/{userId} {
        allow read: if isTenantMemberAnyState(tenantId);
        // Only Cloud Functions create members (workspace creation, acceptWorkspaceInvite with seat checks).
        allow create: if false;
        // Guest → full member is a seat change: only via setWorkspaceMemberRole (callable, seat check).
        allow update: if canSelfUpdateMembership(userId) ||
          (request.resource.data.uid == resource.data.uid &&
            canManageMemberRole(tenantId, resource.data.role, request.resource.data.role) &&
            !(resource.data.role == 'Guest' && request.resource.data.role != 'Guest'));
        allow delete: if canManageMemberRole(tenantId, resource.data.role, 'Member') ||
          (authed() && request.auth.uid == userId && resource.data.role != 'Owner');
      }

      // Invitations (email-bound or shareable link). The document id is the
      // secret handed out in the invite link, so a direct get is allowed for
      // any signed-in user; listing is admin-only. Acceptance happens in the
      // `acceptWorkspaceInvite` Cloud Function.
      match /invitations/{inviteId} {
        allow get: if authed();
        allow list: if isTenantAdmin(tenantId);
        allow create: if isTenantAdmin(tenantId) && planAllowsInvites(tenantId) &&
          request.resource.data.status == 'pending' &&
          request.resource.data.invitedBy == request.auth.uid &&
          request.resource.data.role in ['Admin', 'Member', 'Guest'] &&
          (request.resource.data.role != 'Admin' || isOwner(tenantId));
        allow update: if isTenantAdmin(tenantId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revokedAt', 'revokedBy', 'expiresAt']);
        allow delete: if isTenantAdmin(tenantId);
      }

      // Custom role definitions (Discord-style permission model). Any tenant
      // member may read them (needed to evaluate/display permissions); only the
      // tenant owner may create/modify/delete them.
      match /roles/{roleId} {
        allow read: if isTenantMember(tenantId);
        allow create, update, delete: if isTenantAdmin(tenantId);
      }

      // Presence/online-state moved to Realtime Database (see database.rules.json).
      // 'presence' stays in the denied-subcollection list below so any stray
      // Firestore writes are rejected.

      match /secrets/{secretId} {
        allow read, write: if false;
      }

      match /api_tokens/{tokenId} {
        allow read, write: if false;
      }

      // AI integrations: audit log and workspace AI policy (Admin SDK / callables only).
      match /ai_audit/{entryId} {
        allow read, write: if false;
      }

      match /ai_config/{configId} {
        allow read, write: if false;
      }

      match /ai_usage/{dayId} {
        allow read, write: if false;
      }

      // In-app AI credits per month (written by the aiAssist function); Owner/Admin may read.
      match /ai_credits/{month} {
        allow read: if isTenantAdmin(tenantId);
        allow write: if false;
        match /users/{memberUid} {
          allow read: if isTenantAdmin(tenantId);
          allow write: if false;
        }
      }

      // Workspace activity stream (brain/plans/activity-events-contract.md). Written only by
      // Cloud Functions. Guests see events of their projects only; their queries must filter
      // projectId (== or in) so the rule can be proven per query. projectId null = full members only.
      match /activity/{eventId} {
        allow read: if isFullMember(tenantId) ||
          (
            isTenantMember(tenantId) &&
            resource.data.projectId is string &&
            canAccessProjectById(tenantId, resource.data.projectId)
          );
        allow write: if false;
      }

      // Flows (automations, brain/plans/flows-concept.md). Writes only via Cloud Functions callables
      // (saving validates the owner's permission ceiling). Guests never see flows.
      // Forms (brain/plans/forms-concept.md §4, §10). Every write goes through Cloud Functions.
      match /forms/{formId} {
        allow read: if canEditFormData(tenantId, resource.data);
        allow write: if false;

        match /versions/{versionId} {
          allow read: if canEditForm(tenantId, formId);
          allow write: if false;
        }

        match /responses/{responseId} {
          allow read: if canEditForm(tenantId, formId);
          allow write: if false;
        }

        match /stats/{statsId} {
          allow read: if canEditForm(tenantId, formId);
          allow write: if false;
        }
      }

      match /form_themes/{themeId} {
        allow read: if isFullMember(tenantId);
        allow write: if false;
      }

      match /forms_usage/{monthId} {
        allow read: if isFullMember(tenantId);
        allow write: if false;
      }

      match /automations/{automationId} {
        allow read: if isFullMember(tenantId);
        allow write: if false;
      }

      match /automation_runs/{runId} {
        allow read: if isFullMember(tenantId);
        allow write: if false;
      }

      match /automation_usage/{monthId} {
        allow read: if isFullMember(tenantId);
        allow write: if false;
      }

      match /automation_throttle/{key} {
        allow read, write: if false;
      }

      // Precomputed workspace insights and AI weekly reports (Cloud Functions only; no guests).
      match /insights_daily/{dayId} {
        allow read: if isFullMember(tenantId);
        allow write: if false;
      }

      match /insights_reports/{reportId} {
        allow read: if isFullMember(tenantId);
        allow write: if false;
      }

      // A file inherits its object's access (brain/plans/files-concept.md): project files follow
      // the project (guests only in their projects), workspace files (projectId null) need a
      // non-guest. Guests must filter queries by projectId. Writes go through Callables only.
      match /files/{fileId} {
        allow read: if canAccessTenant(tenantId) ||
          (resource.data.get('projectId', null) is string &&
            canAccessProjectById(tenantId, resource.data.projectId));
        allow write: if false;
      }

      match /file_upload_drafts/{draftId} {
        allow read: if false;
        allow write: if false;
      }

      match /entitlements/{docId} {
        allow read: if isTenantMember(tenantId);
        // Plan, seats and billing flags are granted server-side only.
        allow write: if false;
      }

      match /projects/{projectId} {
        // resource.data (not get()) so guests can run list queries filtered
        // by memberIds array-contains their uid.
        allow read: if isFullMember(tenantId) ||
          (isTenantMember(tenantId) && isProjectMember(resource.data));
        allow create: if isFullMember(tenantId) && request.resource.data.tenantId == tenantId &&
          withinProjectLimit(tenantId);
        // Ownership moves only via the tenant admins or the current project
        // owner; guests can edit project content but not its membership.
        allow update: if canAccessProjectById(tenantId, projectId) && !projectLocked(tenantId, projectId) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tenantId']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId']) ||
            isTenantAdmin(tenantId) ||
            (isFullMember(tenantId) && resource.data.ownerId == request.auth.uid)
          ) &&
          (
            isFullMember(tenantId) ||
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['memberIds', 'members'])
          );
        allow delete: if isTenantAdmin(tenantId) ||
          (isFullMember(tenantId) && resource.data.ownerId == request.auth.uid);

        // At least one segment below the project: `/{document=**}` alone also
        // matches the project doc itself and would bypass the delete rule above.
        match /{subcollection}/{document=**} {
          allow read: if canAccessProjectById(tenantId, projectId) &&
            !isRetiredProjectCollection(subcollection);
        }

        // Writes only two levels deep (e.g. tasks/{t}, tasks/{t}/subtasks/{s}) and never into
        // server-trusted collection names: arbitrary nested paths were a forging ground for
        // path-injected ids (audit 2026-10-24, C1).
        function canWriteProjectContent(subcollection) {
          // No writes below a missing project: a still-open page must not
          // recreate orphaned subcollections after the project was deleted.
          return canAccessProjectById(tenantId, projectId) && projectExists(tenantId, projectId) &&
            !isRetiredProjectCollection(subcollection) && !projectLocked(tenantId, projectId);
        }

        match /{subcollection}/{docId} {
          allow write: if canWriteProjectContent(subcollection);
        }

        match /{subcollection}/{docId}/{nested}/{nestedId} {
          allow write: if canWriteProjectContent(subcollection) && !isServerOnlyName(nested);
        }
      }

      // User-owned tenant data (for example personal tasks)
      // Only the known per-user collections (personal tasks, project nav prefs, wiki prefs); a recursive
      // wildcard let any member write e.g. users/{uid}/members/{uid} (audit 2026-10-24, C1).
      match /users/{userId} {
        allow read, write: if authed() && request.auth.uid == userId && isTenantMember(tenantId);

        match /{collection}/{docId} {
          allow read, write: if authed() && request.auth.uid == userId && isTenantMember(tenantId) &&
            collection in ['personalTasks', 'projectNavPrefs', 'prefs'];
        }
      }

      // Wiki & Docs (brain/plans/wiki-concept.md). Workspace pages: full members only.
      // Project pages: like project tasks (full members + guests of that project).
      // The page body lives in chunks below the meta doc so the tree stays cheap.
      match /docs/{docId} {
        function docPath() {
          return /databases/$(database)/documents/tenants/$(tenantId)/docs/$(docId);
        }
        function canAccessDocSpace(data) {
          return isFullMember(tenantId) || (
            data.spaceType == 'project' && data.projectId is string &&
            canAccessProjectById(tenantId, data.projectId)
          );
        }
        function validSpace(data) {
          return data.tenantId == tenantId && (
            (data.spaceType == 'workspace' && data.projectId == null) ||
            (data.spaceType == 'project' && data.projectId is string && projectExists(tenantId, data.projectId))
          );
        }

        allow read: if canAccessDocSpace(resource.data);
        allow create: if validSpace(request.resource.data) &&
          request.resource.data.createdBy == request.auth.uid &&
          canAccessDocSpace(request.resource.data);
        allow update: if canAccessDocSpace(resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tenantId', 'spaceType', 'projectId', 'createdBy', 'createdAt']);
        allow delete: if canAccessDocSpace(resource.data) &&
          (isTenantAdmin(tenantId) || resource.data.createdBy == request.auth.uid);

        match /body/{chunkId} {
          allow read: if canAccessDocSpace(get(docPath()).data);
          allow create, update: if canAccessDocSpace(getAfter(docPath()).data);
          allow delete: if exists(docPath()) && canAccessDocSpace(get(docPath()).data);
        }

        match /versions/{versionId} {
          allow read, delete: if exists(docPath()) && canAccessDocSpace(get(docPath()).data);
          allow create: if canAccessDocSpace(getAfter(docPath()).data) &&
            request.resource.data.createdBy == request.auth.uid;
          allow update: if false;
        }

        // Presence heartbeat ("X is editing"): everyone with access reads, each user writes their own.
        match /editors/{userId} {
          allow read: if exists(docPath()) && canAccessDocSpace(get(docPath()).data);
          allow write: if authed() && request.auth.uid == userId &&
            exists(docPath()) && canAccessDocSpace(get(docPath()).data);
        }
      }

      // finance_* collections: data of the removed Finance V2 module (2026-10-23). Kept in
      // Firestore but closed to clients — the generic rules below exclude them.

      // Notifications are created by Cloud Functions only. The recipient may read
      // them, flip `read` and delete them; other members can neither see nor forge them.
      match /notifications/{notificationId} {
        allow read, delete: if isTenantMember(tenantId) && resource.data.userId == request.auth.uid;
        allow update: if isTenantMember(tenantId) && resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow create: if false;
      }

      // Push/e-mail delivery results per notification (server-written).
      match /notificationDeliveryLogs/{logId} {
        allow read: if isTenantMember(tenantId) && resource.data.userId == request.auth.uid;
        allow write: if false;
      }

      // Other direct tenant-scoped collections (groups, labels, etc.)
      match /{subcollection}/{docId} {
        // Guests may read/update docs addressed to them.
        allow read, update: if isTenantMember(tenantId) &&
          ('userId' in resource.data) && resource.data.userId == request.auth.uid &&
          !(subcollection.matches('finance_.*') || subcollection in ['secrets', 'api_tokens', 'ai_audit', 'ai_config', 'ai_usage', 'ai_credits', 'file_upload_drafts', 'notifications', 'notificationDeliveryLogs', 'activity', 'insights_daily', 'insights_reports', 'automations', 'automation_runs', 'automation_usage', 'automation_throttle', 'suspension_log', 'billing_log', 'forms', 'form_themes', 'forms_usage']);
        allow read, write: if canAccessTenant(tenantId) &&
          !(
            subcollection.matches('finance_.*') ||
            subcollection in [
              'members',
              'roles',
              'presence',
              'secrets',
              'entitlements',
              'invitations',
              'projects',
              'users',
              'api_tokens',
              'ai_audit',
              'ai_config',
              'ai_usage',
              'ai_credits',
              'suspension_log',
              'billing_log',
              'files',
              'file_upload_drafts',
              'notifications',
              'notificationDeliveryLogs',
              'docs',
              'activity',
              'insights_daily',
              'insights_reports',
              'automations',
              'automation_runs',
              'automation_usage',
              'automation_throttle',
              'forms',
              'form_themes',
              'forms_usage'
            ]
          );
      }
    }

    // Collection group access: "my workspaces" and pending invites for my
    // (verified) email address.
    match /{path=**}/members/{memberId} {
      allow read: if authed() && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/invitations/{inviteId} {
      allow read: if authed() &&
        request.auth.token.email_verified == true &&
        resource.data.email == request.auth.token.email.lower() &&
        resource.data.status == 'pending';
    }

    // Collection group access for project discovery
    match /{path=**}/projects/{projectId} {
      allow read: if canAccessScopedDoc(resource.data) ||
        (('tenantId' in resource.data) && isTenantMember(resource.data.tenantId) && isProjectMember(resource.data));
    }

    match /{path=**}/tasks/{taskId} {
      allow read: if canAccessScopedDoc(resource.data);
    }

    match /{path=**}/initiatives/{initiativeId} {
      allow read: if canAccessScopedDoc(resource.data);
    }
  }
}
